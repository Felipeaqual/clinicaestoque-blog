---
import Base from '../layouts/Base.astro';
import { site, urlAbsoluta } from '../config/site';

const canonical = urlAbsoluta('/');
---
<Base
  tipoPagina="404"
  descricao="A página que você procurou não existe ou mudou de endereço."
  canonical={canonical}
  noindex
>
  <div class="erro-404">
    <h1>Página não encontrada</h1>
    <p style="color: var(--muted);">
      O endereço digitado não corresponde a nenhum post do blog.
    </p>
    <p style="margin-top: 2rem;">
      <a class="btn-cta" href={site.base + '/'}>Voltar para o blog</a>
    </p>
  </div>
</Base>
