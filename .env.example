# Preencha esses valores somente na Vercel. Mantenha vazio no local.

# Vem do passo "Create new app" do Keystatic (ex: clinicaestoque-blog-editor).
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Vem da pagina do GitHub App apos criar.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# String aleatoria de 32+ caracteres. Gere com:
#   openssl rand -hex 32
KEYSTATIC_SECRET=
